
#include <stdio.h>
#define MAX 5

int stack[MAX], top = -1;

int main()
{
    int ch, x;

    while (1)
    {
        printf("\n1. Push  2. Pop  3. Display  4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &ch);

        if (ch == 1)
        {
            if (top == MAX - 1)
                printf("Stack Overflow");
            else
            {
                printf("Enter element: ");
                scanf("%d", &x);
                stack[++top] = x;
            }
        }
        else if (ch == 2)
        {
            if (top == -1)
                printf("Stack Underflow");
            else
                printf("Popped: %d", stack[top--]);
        }
        else if (ch == 3)
        {
            if (top == -1)
                printf("Stack is Empty");
            else
            {
                printf("Stack elements: ");
                for (int i = top; i >= 0; i--)
                    printf("%d ", stack[i]);
            }
        }
        else if (ch == 4)
            break;
        else
            printf("Invalid Choice");
    }

    return 0;
}
