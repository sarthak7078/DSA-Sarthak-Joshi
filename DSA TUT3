#include <stdio.h>

void bubblesort(int arr[], int n)
{
    int i, j, temp;

    for (i = 0; i < n - 1; i++)
    {
        for (j = 0; j < n - 1 - i; j++)
        {
            if (arr[j] > arr[j + 1])
            {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

void myarray(int arr[], int n)
{
    int i;

    for (i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }
}

int main()
{
    int arr[] = {78, 45, 79, 46, 12, 13, 20};
    int n = sizeof(arr) / sizeof(arr[0]);

    printf("Unsorted array:\n");
    myarray(arr, n);

    printf("\n\nSorted array is:\n");
    bubblesort(arr, n);
    myarray(arr, n);

    return 0;
}
